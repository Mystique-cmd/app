<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="MIAMI SUPERMARKET"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="RECEIPT"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvReceiptDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="" />

        <TableLayout
            android:id="@+id/receiptTable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="*">

            <TableRow android:background="#DDDDDD">
                <TextView android:padding="8dp" android:text="ITEM" android:textStyle="bold" />
                <TextView android:padding="8dp" android:text="QUANTITY" android:textStyle="bold" />
                <TextView android:padding="8dp" android:text="UNIT (KES)" android:textStyle="bold" />
                <TextView android:padding="8dp" android:text="TOTAL (KES)" android:textStyle="bold" />
            </TableRow>
        </TableLayout>

        <TextView
            android:id="@+id/tvGrandTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:text="GRAND TOTAL: 0.00"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNewSale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="NEW SALE" />
    </LinearLayout>
</ScrollView>